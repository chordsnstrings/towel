# Optional overrides for local development or the alternative Docker deployment.
# The Netlify + Neon setup does not need this file or manual environment values.
# Start locally with: npm run setup:admin -- --local && npm run dev
PORT=8080
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
DEMO_MODE=false
DATA_DIR=data/local

# Optional external database for local/Docker use. Netlify reads its private
# configuration store, populated by npm run setup:netlify.
# DATABASE_URL=postgresql://move:password@localhost:5432/move
# DATABASE_SSL=false
# DATABASE_CA_CERT=

# Legacy initial bootstrap only; ignored once a database administrator exists.
# Prefer npm run setup:admin, then change the temporary login in the app.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
