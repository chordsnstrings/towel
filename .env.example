# Local development. Copy to .env and replace these two values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
PORT=8080
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
DEMO_MODE=false

# Optional locally; required in production. Without this, development uses
# embedded PostgreSQL (PGlite) at DATA_DIR. Hosted deployments require PostgreSQL.
# On Netlify, set DATABASE_URL to a managed provider's PostgreSQL URL.
# For Neon, use the direct URL (Connection pooling off in its Connect dialog).
# Set it together with APP_ORIGIN, ADMIN_EMAIL and ADMIN_PASSWORD in Netlify's
# environment settings, including the Functions scope. See docs/DEPLOYMENT.md.
# DATABASE_URL=postgresql://move:password@localhost:5432/move
# DATABASE_SSL=false
# DATABASE_CA_CERT=
DATA_DIR=data/local
